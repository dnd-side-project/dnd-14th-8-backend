FROM eclipse-temurin:25-jdk AS builder
WORKDIR /app

COPY gradlew build.gradle settings.gradle ./
COPY gradle ./gradle
COPY src ./src
RUN chmod +x gradlew && ./gradlew bootJar --no-daemon --max-workers=2 \
    -Dorg.gradle.jvmargs="-Xmx512m -XX:MaxMetaspaceSize=256m"

FROM eclipse-temurin:25-jre
WORKDIR /app
ENV TZ=Asia/Seoul
# 512MB 인스턴스에서 힙 외 메모리를 위한 공간을 남긴다. Render 환경변수로 변경 가능.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=50.0 -XX:InitialRAMPercentage=10.0 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=64m -Xss512k -Duser.timezone=Asia/Seoul"
COPY --from=builder --chown=10001:10001 /app/build/libs/*.jar app.jar
USER 10001:10001
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "app.jar"]
