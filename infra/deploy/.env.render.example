# Render Environment 입력용 예시. 실제 값이 있는 파일은 git에 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=prod,render
# Neon Connect에서 pooling을 끄고 확인한 호스트/DB 이름. 비밀번호는 URL에 넣지 않는다.
DB_JDBC_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require&channelBinding=require&connectTimeout=10
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-with-neon-password
KAKAO_API_KEY=replace-with-kakao-rest-api-key
GOOGLE_API_KEY=replace-with-google-routes-key
ODSAY_API_KEY=replace-with-odsay-server-key
# Blueprint가 자동 생성한다. 수동 서비스 생성 시 openssl rand -hex 32 등으로 생성한다.
ADMIN_TOKEN=replace-with-random-admin-token
